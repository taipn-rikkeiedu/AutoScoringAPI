{
  "manifest_version": 3,
  "name": "AI GitHub Grader",
  "version": "1.1.0",
  "description": "Đánh giá mã nguồn GitHub bằng AI với giao diện hiện đại và cấu hình linh hoạt.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.github.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
